# =================================================================
# NagarSeva Environment Configuration
# Copy this file to .env before starting Docker or local services:
# cp .env.example .env
# =================================================================

# Server & Network Ports
PORT=8080
FRONTEND_PORT=5173

# PostgreSQL Database Configuration
POSTGRES_DB=nagarsevadb
POSTGRES_USER=nagarseva
POSTGRES_PASSWORD=nagarseva_dev
POSTGRES_PORT=5432

# Redis Cache & Rate Limiting
REDIS_PORT=6379

# Google Gemini AI (Optional - falls back to offline civic heuristics if omitted)
# Get a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK (Optional - falls back to zero-config local auth if omitted)
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Object Storage / AWS S3 (Optional - uses local Base64 storage by default)
APP_STORAGE_S3_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=nagarseva-media
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
