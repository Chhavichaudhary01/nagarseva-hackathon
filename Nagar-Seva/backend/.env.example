# ===================================================================
# NagarSeva Backend Environment Configuration
# Copy this file to .env in this directory or in the workspace root
# ===================================================================

# Google Gemini API Key (Required for live Gemini 1.5 multimodal AI)
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=

# Gemini Model (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Firebase Admin SDK Credentials Path (optional for dev, required for production)
# FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# Server Port (default: 8080)
PORT=8080
